[Unit]
Description=DVPX Reflector (Digi Voice Protocol eXtended)
Documentation=file:/opt/dvpx/DVPX/dvpx-reflector/KURULUM.md
# Reflektörün veritabanı bağımlılığı YOKTUR; yalnızca ağ gerekir.
# Panele (HTTPS) ulaşamazsa da başlar ve önbellekteki politikayla çalışır.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Kurulum yolunuza göre düzenleyin / adjust to your installation path
WorkingDirectory=/opt/dvpx/DVPX/dvpx-reflector
ExecStart=/usr/bin/node src/index.js

# Ayrıcalıksız kullanıcı ile çalıştırın:
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin dvpx
User=dvpx
Group=dvpx

Restart=always
RestartSec=5

# Günlükler journalctl'e / logs go to journalctl
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dvpx-reflector

# Güvenlik sıkılaştırma / hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false

# Reflektör politikanın son kopyasını buraya yazar (policy.cache.json).
# Böylece panel erişilemezken yeniden başlatılsa da hizmet verebilir.
# ProtectSystem=strict tüm dosya sistemini salt-okunur yaptığı için bu dizine
# açıkça yazma izni vermek GEREKİR; yolu kendi kurulumunuza göre düzeltin.
ReadWritePaths=/opt/dvpx/DVPX/dvpx-reflector

# Kaynak sınırları / resource limits
LimitNOFILE=65535
MemoryMax=512M

[Install]
WantedBy=multi-user.target
